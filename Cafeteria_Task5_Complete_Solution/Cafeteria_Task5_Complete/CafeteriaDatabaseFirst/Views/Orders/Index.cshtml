@model List<PurchaseOrder>
@{ ViewData["Title"] = "Purchase Orders"; }
<div class="heading"><h1>Purchase Orders</h1><a class="button" asp-action="Create">+ New Purchase Order</a></div>
<div class="card table-wrap">
<table>
    <thead><tr><th>Order #</th><th>Date (UTC)</th><th>Supplier</th><th>Lines</th><th>Total (JD)</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var order in Model)
    {
        <tr>
            <td>#@order.Id</td><td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
            <td>@order.Supplier?.Name</td><td>@order.PurchaseOrderItems.Count</td>
            <td>@order.PurchaseOrderItems.Sum(i => i.Quantity * i.UnitPrice).ToString("0.00")</td>
            <td><span class="status">@order.Status</span></td>
            <td class="actions"><a asp-action="Details" asp-route-id="@order.Id">Details</a>
                @if (order.Status == "Pending")
                {
                    <form asp-action="Delete" asp-route-id="@order.Id" method="post" onsubmit="return confirm('Delete this pending order?');">
                        <button class="danger" type="submit">Delete</button></form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="muted empty">No purchase orders yet.</p> }
</div>
