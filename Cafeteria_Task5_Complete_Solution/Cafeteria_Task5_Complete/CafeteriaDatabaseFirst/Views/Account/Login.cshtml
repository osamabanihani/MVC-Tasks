@model LoginVm
@{
    ViewData["Title"] = "Employee Login";
}
<section class="card small-card">
    <h1>Employee Sign In</h1>
    <p class="muted">University cafeteria management system</p>
    <form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post">
        <div asp-validation-summary="All" class="validation"></div>
        <label>Username <input asp-for="Username" autocomplete="username" /></label>
        <label>Password <input asp-for="Password" type="password" autocomplete="current-password" /></label>
        <button type="submit">Sign In</button>
    </form>
    <p class="muted small">Local demo only: employee / Demo123! · Change before deployment.</p>
</section>
