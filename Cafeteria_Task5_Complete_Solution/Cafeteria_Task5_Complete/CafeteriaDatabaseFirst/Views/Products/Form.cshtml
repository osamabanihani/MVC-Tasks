@model Product
@{
    bool edit = Model.Id > 0;
    ViewData["Title"] = edit ? "Edit Product" : "Add Product";
}
<h1>@ViewData["Title"]</h1>
<div class="card form-card">
<form asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="validation"></div>
    <label>Name <input asp-for="Name" maxlength="100" required /></label>
    <label>Price (JD) <input asp-for="Price" type="number" min="0" step="0.01" required /></label>
    <label>Quantity in Stock <input asp-for="Quantity" type="number" min="0" required /></label>
    <label>Category <select asp-for="CategoryId" asp-items="ViewBag.Categories"><option value="0">Select category</option></select></label>
    <label>Supplier <select asp-for="SupplierId" asp-items="ViewBag.Suppliers"><option value="0">Select supplier</option></select></label>
    <div class="buttons"><button type="submit">Save Product</button><a class="button secondary" asp-action="Index">Cancel</a></div>
</form>
</div>
