@model Category
@{
    bool edit = Model.Id > 0;
    ViewData["Title"] = edit ? "Edit Category" : "Add Category";
}
<h1>@ViewData["Title"]</h1>
<div class="card form-card">
<form asp-action="@(edit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="validation"></div>
    <label>Name <input asp-for="Name" maxlength="100" required /></label>
    <label>Description <textarea asp-for="Description" maxlength="500" rows="3"></textarea></label>
    <div class="buttons"><button type="submit">Save Category</button><a class="button secondary" asp-action="Index">Cancel</a></div>
</form>
</div>
