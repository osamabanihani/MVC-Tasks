@model Product
@{ ViewData["Title"] = "Product Details"; }
<div class="heading"><h1>@Model.Name</h1><a class="button secondary" asp-action="Index">Back to Products</a></div>
<div class="card details">
    <p><strong>Product ID:</strong> @Model.Id</p>
    <p><strong>Category:</strong> @Model.Category?.Name</p>
    <p><strong>Supplier:</strong> @Model.Supplier?.Name</p>
    <p><strong>Unit Price:</strong> @Model.Price.ToString("0.00") JD</p>
    <p><strong>Available Stock:</strong> @Model.Quantity</p>
    <a class="button" asp-action="Edit" asp-route-id="@Model.Id">Edit Product</a>
</div>
