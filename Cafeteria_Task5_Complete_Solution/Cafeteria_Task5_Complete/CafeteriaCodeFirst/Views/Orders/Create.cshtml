@model PurchaseOrderFormVm
@{
    ViewData["Title"] = "New Purchase Order";
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var products = (List<Product>)ViewBag.Products;
}
<h1>Create Purchase Order</h1>
<p class="muted">Choose a supplier, then add one or more of that supplier's products. Stock changes only after marking the order Received.</p>
<div class="card form-card order-card">
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="validation"></div>
    <label>Supplier
        <select asp-for="SupplierId" id="supplier">
            <option value="0">Choose supplier</option>
            @foreach (var s in suppliers)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </label>
    <h2>Order Items</h2>
    <div id="item-rows">
        @for (int i = 0; i < Model.Items.Count; i++)
        {
            <div class="item-row">
                <select name="Items[@i].ProductId" class="product-select" data-selected="@Model.Items[i].ProductId">
                    <option value="0">Choose product</option>
                    @foreach (var p in products)
                    {
                        <option value="@p.Id" data-supplier="@p.SupplierId">@p.Name (@p.Price.ToString("0.00") JD)</option>
                    }
                </select>
                <input type="number" name="Items[@i].Quantity" min="1" value="@Model.Items[i].Quantity" placeholder="Quantity" />
            </div>
        }
    </div>
    <div class="buttons"><button type="button" class="secondary" id="add-row">+ Add Another Product</button></div>
    <div class="buttons"><button type="submit">Save Pending Order</button><a class="button secondary" asp-action="Index">Cancel</a></div>
</form>
</div>
<template id="row-template">
    <div class="item-row">
        <select name="Items[INDEX].ProductId" class="product-select">
            <option value="0">Choose product</option>
            @foreach (var p in products)
            {
                <option value="@p.Id" data-supplier="@p.SupplierId">@p.Name (@p.Price.ToString("0.00") JD)</option>
            }
        </select>
        <input type="number" name="Items[INDEX].Quantity" min="1" value="1" placeholder="Quantity" />
    </div>
</template>
@section Scripts {
<script>
(() => {
  const root = document.getElementById('item-rows');
  const supplier = document.getElementById('supplier');
  let nextIndex = root.querySelectorAll('.item-row').length;

  function filterProducts() {
    root.querySelectorAll('.product-select').forEach(select => {
      Array.from(select.options).forEach(opt => {
        if (!opt.dataset.supplier) return;
        const allowed = opt.dataset.supplier === supplier.value;
        opt.disabled = !allowed;
        opt.hidden = !allowed;
      });
      if (select.selectedOptions.length && select.selectedOptions[0].disabled) select.value = '0';
    });
  }
  root.querySelectorAll('.product-select').forEach(select => { select.value = select.dataset.selected || '0'; });
  filterProducts();

  document.getElementById('add-row').addEventListener('click', () => {
    const html = document.getElementById('row-template').innerHTML.replaceAll('INDEX', nextIndex++);
    root.insertAdjacentHTML('beforeend', html);
    filterProducts();
  });
  supplier.addEventListener('change', filterProducts);
})();
</script>
}
