@model List<Supplier>
@{ ViewData["Title"] = "Suppliers"; }
<div class="heading"><h1>Suppliers</h1><a class="button" asp-action="Create">+ New Supplier</a></div>
<div class="card table-wrap">
<table>
    <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Actions</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.Id</td><td>@item.Name</td><td>@item.Email</td><td>@item.Phone</td>
            <td class="actions"><a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Delete this supplier?');">
                    <button type="submit" class="danger">Delete</button></form></td></tr>
    }
    </tbody>
</table>
@if (!Model.Any()) { <p class="muted empty">No suppliers yet.</p> }
</div>
