@{
    ViewData["Title"] = "Home";
}
<div class="page-heading mb-4">
    <h1>University Cafeteria</h1>
    <p class="text-muted">Supply Management System</p>
</div>
<h4 class="mb-3">Product Categories</h4>
<ul class="list-group">
    @foreach (string category in ViewBag.Categories)
    {
        <li class="list-group-item">@category</li>
    }
</ul>
<a class="btn btn-primary mt-4" asp-controller="Supply" asp-action="CreateRequest">Create Supply Request</a>
