@{
    ViewData["Title"] = "Create Request";
}
<h1>Create Supply Request</h1>
<p class="text-muted">Enter the required supply details below.</p>
<div class="card p-4 form-card">
    <form asp-controller="Supply" asp-action="SubmitRequest" method="post" novalidate>
        <div class="mb-3">
            <label for="employee" class="form-label">Employee Name</label>
            <input id="employee" type="text" name="EmployeeName" class="form-control" placeholder="Employee name" />
        </div>
        <div class="mb-3">
            <label for="product" class="form-label">Product Name</label>
            <select id="product" name="ProductName" class="form-select">
                <option>Water</option>
                <option>Orange Juice</option>
                <option>Coffee</option>
                <option>Sandwich</option>
                <option>Chocolate</option>
            </select>
        </div>
        <div class="mb-3">
            <label for="quantity" class="form-label">Quantity</label>
            <input id="quantity" type="number" name="Quantity" min="1" class="form-control" />
        </div>
        <div class="mb-3">
            <label for="requiredDate" class="form-label">Required Date</label>
            <input id="requiredDate" type="date" name="RequiredDate" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Submit Request</button>
    </form>
</div>
