<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - University Cafeteria</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Supply" asp-action="Index">University Cafeteria</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainMenu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Supply" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Supply" asp-action="Products">Products</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Supply" asp-action="Suppliers">Suppliers</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Supply" asp-action="CreateRequest">Create Request</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Supply" asp-action="About">About</a></li>
                </ul>
            </div>
        </div>
    </nav>
    <main class="container py-5">
        @RenderBody()
    </main>
    <footer class="border-top text-muted py-3">
        <div class="container">University Cafeteria — Supply Management System</div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
