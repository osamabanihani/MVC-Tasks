@model Employee
@{ ViewData["Title"] = "Edit Employee"; }

<h1>Edit Employee</h1>
<div class="panel form-panel">
@using (Html.BeginForm("Edit", "Employee", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    <div class="form-group">
        @Html.LabelFor(m => m.FullName, "Full Name")
        @Html.TextBoxFor(m => m.FullName, new { @class = "input", type = "text" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Phone, "Phone")
        @Html.TextBoxFor(m => m.Phone, new { @class = "input", type = "text" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Email, "Email")
        @Html.TextBoxFor(m => m.Email, new { @class = "input", type = "email" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Position, "Position")
        @Html.TextBoxFor(m => m.Position, new { @class = "input", type = "text" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Salary, "Salary")
        @Html.TextBoxFor(m => m.Salary, new { @class = "input", type = "number", step = "0.01" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.HireDate, "Hire Date")
        @Html.TextBoxFor(m => m.HireDate, "{0:yyyy-MM-dd}", new { @class = "input", type = "date" })
    </div>
    <button class="button" type="submit">Save</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "button secondary" })
}
</div>
