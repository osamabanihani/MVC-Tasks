@model Order
@{ ViewData["Title"] = "Create Order"; }

<h1>Create Order</h1>
<div class="panel form-panel">
@using (Html.BeginForm("Create", "Order", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        @Html.LabelFor(m => m.CustomerName, "Customer Name")
        @Html.TextBoxFor(m => m.CustomerName, new { @class = "input", type = "text" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.OrderDate, "Order Date")
        @Html.TextBoxFor(m => m.OrderDate, "{0:yyyy-MM-dd}", new { @class = "input", type = "date" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.TotalPrice, "Total Price")
        @Html.TextBoxFor(m => m.TotalPrice, new { @class = "input", type = "number", step = "0.01" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Status, "Status")
        @Html.TextBoxFor(m => m.Status, new { @class = "input" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.EmployeeId, "Employee")
        @Html.DropDownListFor(m => m.EmployeeId, (IEnumerable<SelectListItem>)ViewBag.Employees, "-- Select Employee --", new { @class = "input" })
    </div>
    <button class="button" type="submit">Save</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "button secondary" })
}
</div>
