@model List<Category>
@{ ViewData["Title"] = "Categories"; }

<div class="page-heading">
    <h1>Categories</h1>
    <a class="button" href="@Url.Action("Create", "Category")">+ Add New</a>
</div>

@if (TempData["Error"] != null)
{
    <p class="error">@TempData["Error"]</p>
}

<div class="panel table-scroll">
<table>
    <thead>
        <tr><th>ID</th><th>Name</th><th>Description</th><th>Products Count</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.Id</td><td>@item.Name</td><td>@item.Description</td><td>@item.Products.Count</td><td class="actions">
            @Html.ActionLink("Details", "Details", new { id = item.Id })
            @Html.ActionLink("Edit", "Edit", new { id = item.Id })
            @using (Html.BeginForm("Delete", "Category", new { id = item.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="delete" onclick="return confirm('Delete this category?')">Delete</button>
            }
        </td></tr>
    }
    </tbody>
</table>
</div>
