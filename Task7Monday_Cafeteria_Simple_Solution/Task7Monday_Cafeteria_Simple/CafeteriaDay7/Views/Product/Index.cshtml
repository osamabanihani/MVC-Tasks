@model List<Product>
@{ ViewData["Title"] = "Products"; }

<div class="page-heading">
    <h1>Products</h1>
    <a class="button" href="@Url.Action("Create", "Product")">+ Add New</a>
</div>

@if (TempData["Error"] != null)
{
    <p class="error">@TempData["Error"]</p>
}

<div class="panel table-scroll">
<table>
    <thead>
        <tr><th>ID</th><th>Name</th><th>Category</th><th>Supplier</th><th>Price</th><th>Stock</th><th>Actions</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.Id</td><td>@item.Name</td><td>@item.Category?.Name</td><td>@item.Supplier?.Name</td><td>@item.Price.ToString("0.00") JD</td><td>@if (item.Quantity < 5) { <span class="low-stock">Low Stock (@item.Quantity)</span> } else { @item.Quantity }</td><td class="actions">
            @Html.ActionLink("Details", "Details", new { id = item.Id })
            @Html.ActionLink("Edit", "Edit", new { id = item.Id })
            @using (Html.BeginForm("Delete", "Product", new { id = item.Id }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="delete" onclick="return confirm('Delete this product?')">Delete</button>
            }
        </td></tr>
    }
    </tbody>
</table>
</div>
