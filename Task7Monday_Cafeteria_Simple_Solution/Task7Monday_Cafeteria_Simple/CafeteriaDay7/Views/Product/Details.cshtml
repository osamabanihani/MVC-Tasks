@model Product
@{ ViewData["Title"] = "Product Details"; }

<h1>Product Details #@Model.Id</h1>
<div class="panel details">
    <p><strong>Name:</strong> @Html.DisplayFor(m => m.Name)</p>
    <p><strong>Description:</strong> @Html.DisplayFor(m => m.Description)</p>
    <p><strong>Category:</strong> @Model.Category?.Name</p>
    <p><strong>Supplier:</strong> @Model.Supplier?.Name</p>
    <p><strong>Price:</strong> @Model.Price.ToString("0.00") JD</p>
    <p><strong>Quantity:</strong> @Model.Quantity</p>
    <p><strong>Stock:</strong> @(Model.Quantity < 5 ? "Low Stock" : "Available")</p>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "button" })
    @Html.ActionLink("Back to List", "Index", null, new { @class = "button secondary" })
</p>
