@model Product
@{ ViewData["Title"] = "Create Product"; }

<h1>Create Product</h1>
<div class="panel form-panel">
@using (Html.BeginForm("Create", "Product", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        @Html.LabelFor(m => m.Name, "Name")
        @Html.TextBoxFor(m => m.Name, new { @class = "input", type = "text" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Description, "Description")
        @Html.TextAreaFor(m => m.Description, new { @class = "input", rows = 3 })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Price, "Price")
        @Html.TextBoxFor(m => m.Price, new { @class = "input", type = "number", step = "0.01" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Quantity, "Quantity")
        @Html.TextBoxFor(m => m.Quantity, new { @class = "input", type = "number" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.CategoryId, "Category")
        @Html.DropDownListFor(m => m.CategoryId, (IEnumerable<SelectListItem>)ViewBag.Categories, "-- Select Category --", new { @class = "input" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.SupplierId, "Supplier")
        @Html.DropDownListFor(m => m.SupplierId, (IEnumerable<SelectListItem>)ViewBag.Suppliers, "-- Select Supplier --", new { @class = "input" })
    </div>
    <button class="button" type="submit">Save</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "button secondary" })
}
</div>
