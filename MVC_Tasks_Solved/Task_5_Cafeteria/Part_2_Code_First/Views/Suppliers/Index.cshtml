@model List<Supplier>
@{ ViewData["Title"] = "Suppliers"; }
<div class="heading"><h1>Suppliers</h1><a class="btn" asp-action="Create">Add Supplier</a></div>
<div class="card table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Actions</th></tr></thead><tbody>
@foreach (var s in Model) { <tr><td>@s.Name</td><td>@s.Email</td><td>@s.Phone</td><td class="actions">
<a asp-action="Edit" asp-route-id="@s.Id">Edit</a>
<form asp-action="Delete" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Delete this supplier?');"><button class="danger" type="submit">Delete</button></form>
</td></tr> }</tbody></table></div>
