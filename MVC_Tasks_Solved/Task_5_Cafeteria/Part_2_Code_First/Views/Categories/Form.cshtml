@model Category
@{ bool edit = Model.Id > 0; ViewData["Title"] = edit ? "Edit Category" : "New Category"; }
<h1>@ViewData["Title"]</h1><div class="card form-card">
<form asp-action="@(edit ? "Edit" : "Create")" method="post"><input asp-for="Id" type="hidden"/>
<div asp-validation-summary="All" class="error-text"></div>
<label>Name <input asp-for="Name" required maxlength="100" /></label>
<label>Description <textarea asp-for="Description" maxlength="500"></textarea></label>
<button type="submit">Save</button><a class="btn secondary" asp-action="Index">Cancel</a></form></div>
