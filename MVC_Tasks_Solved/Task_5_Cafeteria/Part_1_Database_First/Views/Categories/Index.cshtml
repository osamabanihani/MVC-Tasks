@model List<Category>
@{ ViewData["Title"] = "Categories"; }
<div class="heading"><h1>Categories</h1><a class="btn" asp-action="Create">Add Category</a></div>
<div class="card table-wrap"><table><thead><tr><th>Name</th><th>Description</th><th>Actions</th></tr></thead><tbody>
@foreach (var c in Model) { <tr><td>@c.Name</td><td>@c.Description</td><td class="actions">
<a asp-action="Edit" asp-route-id="@c.Id">Edit</a>
<form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Delete this category?');"><button class="danger" type="submit">Delete</button></form>
</td></tr> }</tbody></table></div>
