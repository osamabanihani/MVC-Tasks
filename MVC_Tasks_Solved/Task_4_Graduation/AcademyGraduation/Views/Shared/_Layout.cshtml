<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] - Graduation Supplies</title><link rel="stylesheet" href="~/css/site.css" /></head>
<body><header><div class="container nav"><strong>🎓 Orange Graduation Supplies</strong><nav>
<a href="@Url.Action("Index", "Supply")">Create Supply Request</a>
<a href="@Url.Action("Review", "Supply")">Review</a>
<a href="@Url.Action("About", "Home")">About</a>
</nav></div></header><main class="container">
@if (TempData["Message"] != null) { <div class="alert success">@TempData["Message"]</div> }
@if (TempData["Error"] != null) { <div class="alert error">@TempData["Error"]</div> }
@RenderBody()</main><footer class="container">Simple ASP.NET Core MVC learning project</footer>
</body></html>
