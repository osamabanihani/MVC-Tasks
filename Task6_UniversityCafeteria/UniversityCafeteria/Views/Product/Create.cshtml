@model Product
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Add Product";
}
<h1>Add Product</h1>
<p class="hint">Create at least one category and one supplier before adding a product.</p>

@using (Html.BeginForm("Create", "Product", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "validation" })

    <div class="field">
        @Html.LabelFor(m => m.Name)
        @Html.TextBoxFor(m => m.Name, new { @class = "input" })
        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "validation" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.Price)
        @Html.TextBoxFor(m => m.Price, new { type = "number", step = "0.01", min = "0.01", @class = "input" })
        @Html.ValidationMessageFor(m => m.Price, "", new { @class = "validation" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.Quantity)
        @Html.TextBoxFor(m => m.Quantity, new { type = "number", min = "0", @class = "input" })
        @Html.ValidationMessageFor(m => m.Quantity, "", new { @class = "validation" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.CategoryId, "Category")
        @Html.DropDownListFor(m => m.CategoryId, (IEnumerable<SelectListItem>)ViewBag.Categories, "-- Select Category --", new { @class = "input" })
        @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "validation" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.SupplierId, "Supplier")
        @Html.DropDownListFor(m => m.SupplierId, (IEnumerable<SelectListItem>)ViewBag.Suppliers, "-- Select Supplier --", new { @class = "input" })
        @Html.ValidationMessageFor(m => m.SupplierId, "", new { @class = "validation" })
    </div>

    <button type="submit" class="button">Save Product</button>
    @Html.ActionLink("Cancel", "Index", "Product", null, new { @class = "button secondary" })
}
