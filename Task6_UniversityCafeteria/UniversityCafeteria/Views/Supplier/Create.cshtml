@model Supplier
@{
    ViewData["Title"] = "Add Supplier";
}
<h1>Add Supplier</h1>

@using (Html.BeginForm("Create", "Supplier", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "validation" })

    <div class="field">
        @Html.LabelFor(m => m.Name)
        @Html.TextBoxFor(m => m.Name, new { @class = "input" })
        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "validation" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.Phone)
        @Html.TextBoxFor(m => m.Phone, new { @class = "input" })
        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "validation" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { type = "email", @class = "input" })
        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "validation" })
    </div>
    <button type="submit" class="button">Save Supplier</button>
    @Html.ActionLink("Cancel", "Index", "Supplier", null, new { @class = "button secondary" })
}
