@{
   
    Layout = "~/Views/Shared/_SimpleLayout.cshtml";

}


<h1>Cafeteria Suppliers</h1>

<p>Welcome to the Suppliers Page.</p>
@{
    string[] suppliers = { "Fresh Food Company", "Happy Drinks Company", "Daily Supplies Company", "Healthy Dairy Company" };
}
<ul>
    @foreach (string supplier in suppliers)
    {
        <li>@supplier</li>
    }
</ul>

@if (suppliers.Length >= 3)
{
    <p>We have enough suppliers.</p>
}
else
{
    <p>We need more suppliers.</p>
}
<a asp-controller="Cafeteria" asp-action="Index">Back to Home</a>