@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Supply Status</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body class="container mt-5">

    <h1>Supply Status</h1>

    @{
        string[] products = {"Water","Orange Juice","Coffee","Sandwich","Chocolate"};

        string[] suppliers = {"Fresh Food Company","Happy Drinks Company","Daily Supplies Company","Fresh Food Company","Daily Supplies Company"};

        int[] quantities = { 100, 20, 50, 0, 5 };

        string[] statuses = { "Available", "Low Stock", "Available", "Out of Stock", "Low Stock" };
    }

    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>Number</th>
                <th>Product Name</th>
                <th>Supplier</th>
                <th>Quantity</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < products.Length; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td>@products[i]</td>
                    <td>@suppliers[i]</td>
                    <td>@quantities[i]</td>
                    <td>
                        @if (statuses[i] == "Available")
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else if (statuses[i] == "Low Stock")
                        {
                            <span class="badge bg-warning text-dark">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Out of Stock</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>