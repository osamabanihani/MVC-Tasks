@model List<SupplyRequest>
@{
    ViewData["Title"] = "Supply Requests";
    bool isAdmin = User.IsInRole("Admin") || User.IsInRole("SuperAdmin");
}
<h1>Supply Requests</h1>
<p><a class="button" asp-action="Create">Create New Request</a></p>
<table>
    <tr><th>ID</th><th>Date</th><th>Owner</th><th>Total (JD)</th><th>Status</th><th>Actions</th></tr>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Id</td>
            <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
            <td>@(r.User?.FullName)</td>
            <td>@r.TotalPrice.ToString("0.00")</td>
            <td>@r.Status</td>
            <td>
                <a asp-action="Details" asp-route-id="@r.Id">Details</a>
                @if (r.Status == "Pending")
                {
                    <a asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="inline"
                          onsubmit="return confirm('Delete this request?');">
                        <button class="danger" type="submit">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
</table>
@if (Model.Count == 0)
{
    <p>No requests yet.</p>
}
