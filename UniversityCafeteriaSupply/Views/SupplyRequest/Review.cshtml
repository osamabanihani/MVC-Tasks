@model SupplyRequestSummary
@{ ViewData["Title"] = "Review Draft"; }
<h1>Review Draft</h1>
@if (Model.Items.Count == 0)
{
    <div class="panel"><p>Your supply request is empty. Add at least one product before confirming.</p>
    <a class="button" href="@Url.Action("Index", "SupplyRequest")">Add Products</a></div>
}
else
{
    <div class="panel">
        <table><thead><tr><th>Product</th><th>Category</th><th>Quantity</th><th>Unit Price</th><th>Priority</th><th>Total</th></tr></thead><tbody>
        @foreach (var item in Model.Items)
        {
            <tr><td>@item.ProductName</td><td>@item.Category</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("0.00") JD</td><td>@item.Priority</td><td>@item.Total.ToString("0.00") JD</td></tr>
        }
        </tbody></table>
        <div class="totals">
            <p>Request Priority: <strong>@Model.Priority</strong></p>
            <p>Subtotal: <strong>@Model.Subtotal.ToString("0.00") JD</strong></p>
            <p>Preparation Fee: <strong>@Model.PreparationFee.ToString("0.00") JD</strong></p>
            <p>Discount: <strong>@Model.Discount.ToString("0.00") JD</strong></p>
            <h2>Final Total: @Model.FinalTotal.ToString("0.00") JD</h2>
        </div>
        <form method="post" action="@Url.Action("ConfirmRequest", "SupplyRequest")">
            @Html.AntiForgeryToken()
            <button type="submit">Confirm Request</button>
        </form>
        <a class="button secondary" href="@Url.Action("Index", "SupplyRequest")">Add More Products</a>
        <form method="post" action="@Url.Action("ClearDraft", "SupplyRequest")" class="inline-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="danger">Clear Draft</button>
        </form>
    </div>
}
