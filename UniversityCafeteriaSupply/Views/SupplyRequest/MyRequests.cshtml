@model List<ConfirmedSupplyRequest>
@{ ViewData["Title"] = "My Requests"; }
<h1>Confirmed Supply Requests</h1>
<div class="panel">
@if (Model.Count == 0)
{
    <p>No confirmed requests yet.</p>
}
else
{
    <table><thead><tr><th>Request ID</th><th>Products</th><th>Subtotal</th><th>Fee</th><th>Discount</th><th>Final Total</th><th>Status</th></tr></thead><tbody>
    @foreach (var request in Model)
    {
        <tr><td>#@request.RequestId</td><td>@request.Items.Count</td><td>@request.Subtotal.ToString("0.00") JD</td><td>@request.PreparationFee.ToString("0.00") JD</td><td>@request.Discount.ToString("0.00") JD</td><td>@request.FinalTotal.ToString("0.00") JD</td><td>@request.Status</td></tr>
    }
    </tbody></table>
}
<a class="button" href="@Url.Action("Index", "SupplyRequest")">New Supply Request</a>
</div>
